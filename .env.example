# DomaineAnalyser — configuration locale
#
# Copier ce fichier en « .env » (fait automatiquement par install.sh / install.cmd).
# Le fichier .env est ignoré par git : il ne doit jamais être versionné.
#
# L'outil est PLEINEMENT fonctionnel sans aucune de ces variables.
# Elles n'activent que l'enrichissement optionnel.

# ---------------------------------------------------------------------------
# Enrichissement IA (optionnel)
# ---------------------------------------------------------------------------
# Clé API Google Gemini, utilisée uniquement lorsque l'option --ai est passée.
# Obtention : https://aistudio.google.com/apikey
#
# Rôle strictement limité : rechercher du contexte public (réputation d'un ASN,
# campagnes signalées, identité d'une organisation). L'IA ne collecte aucune
# donnée elle-même et ne peut ni créer, ni modifier, ni supprimer un constat,
# ni influencer le score de sécurité.
GEMINI_API_KEY=

# Modèle utilisé pour l'enrichissement.
DA_GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Réseau (optionnel)
# ---------------------------------------------------------------------------
# Résolveurs DNS, séparés par des virgules. Vide = résolveurs du système.
# Renseigner des résolveurs publics rend les résultats reproductibles d'une
# machine à l'autre, ce qui est souhaitable pour un audit.
DA_DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Délai maximal par requête DNS, en secondes.
DA_DNS_TIMEOUT=5.0

# Repli DNS-over-HTTPS lorsque le port 53 est filtré (fréquent en entreprise).
DA_DOH_ENABLED=true

# Délai maximal des requêtes HTTP (RDAP, crt.sh), en secondes.
DA_HTTP_TIMEOUT=15.0

# ---------------------------------------------------------------------------
# Stockage (optionnel)
# ---------------------------------------------------------------------------
# Emplacement de la base des rapports DMARC.
# Vide = répertoire de données standard de la plateforme.
DA_DB_PATH=

# ---------------------------------------------------------------------------
# Tests actifs d'usurpation (optionnel — commande « da test-spoof »)
# ---------------------------------------------------------------------------
# Ce sous-système ÉMET réellement des messages. Il ne peut livrer qu'à UNE
# boîte : celle dont il prouve le contrôle en s'y connectant en IMAP ci-dessous.
# Il est donc structurellement incapable d'envoyer du courrier forgé à un tiers.
# N'utilise ces tests que sur une infrastructure que tu possèdes ou pour
# laquelle tu as reçu une autorisation écrite.

# Boîte de vérification = unique destinataire autorisé.
# Vide => prend la valeur de DA_IMAP_USER.
DA_TEST_MAILBOX=failtest@capibara.fr

# Accès IMAP à cette boîte (sert AUSSI de preuve de possession).
DA_IMAP_HOST=mail.capibara.fr
DA_IMAP_PORT=993
DA_IMAP_SSL=true
DA_IMAP_USER=failtest@capibara.fr
DA_IMAP_PASSWORD=

# Consentement explicite : test autorisé sur une infra que tu contrôles.
# La commande refuse de s'exécuter tant que ce n'est pas true.
DA_TEST_ACK=false

# Chemin d'émission :
#   direct = connexion directe au MX du destinataire (spoofeur externe
#            réaliste ; nécessite le port 25 sortant ouvert).
#   relay  = passage par un serveur SMTP authentifié (si le port 25 est filtré,
#            ou pour tester la seule tromperie par nom d'affichage).
DA_SEND_MODE=direct

# Nom présenté en EHLO. Vide = nom d'hôte de la machine. Mets ici le FQDN de
# la machine d'où tu lances les tests, pour un envoi réaliste.
DA_SEND_HELO=

# Relais SMTP (uniquement si DA_SEND_MODE=relay).
DA_SMTP_RELAY_HOST=
DA_SMTP_RELAY_PORT=587
DA_SMTP_RELAY_USER=
DA_SMTP_RELAY_PASSWORD=

# Garde-fous.
DA_TEST_MAX_MESSAGES=25
DA_TEST_SEND_DELAY=1
DA_TEST_VERIFY_TIMEOUT=120
